{
  "name": "@mikbin80/algorithmsts",
  "version": "0.1.0",
  "description": "TypeScript implementation of standard algorithms and data structures",
  "private": false,
  "main": "dist/algorithms/index.cjs",
  "module": "dist/algorithms/index.js",
  "typings": "dist/types/algorithms/index.d.ts",
  "types": "dist/types/algorithms/index.d.ts",
  "exports": {
    "./core": {
      "types": "./dist/types/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./data-structures": {
      "types": "./dist/types/data-structures/index.d.ts",
      "import": "./dist/data-structures/index.js",
      "require": "./dist/data-structures/index.cjs"
    },
    "./algorithms": {
      "types": "./dist/types/algorithms/index.d.ts",
      "import": "./dist/algorithms/index.js",
      "require": "./dist/algorithms/index.cjs"
    },
    "./graphs": {
      "types": "./dist/types/graphs/index.d.ts",
      "import": "./dist/graphs/index.js",
      "require": "./dist/graphs/index.cjs"
    },
    "./performance": {
      "types": "./dist/types/performance/index.d.ts",
      "import": "./dist/performance/index.js",
      "require": "./dist/performance/index.cjs"
    },
    "./types": {
      "types": "./dist/types/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./interfaces": {
      "types": "./dist/types/interfaces.d.ts",
      "import": "./dist/interfaces.js",
      "require": "./dist/interfaces.cjs"
    },
    "./vector-similarity": {
      "types": "./dist/types/vector-similarity/index.d.ts",
      "import": "./dist/vector-similarity/index.js",
      "require": "./dist/vector-similarity/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "author": "Michele Bini <mikbin80@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/MikBin/algorithmsts"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module",
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "scripts": {
    "lint": "eslint \"{src,test,tools}/**/*.ts\"",
    "watch": "rollup -w -c rollup.config.ts --configPlugin typescript --environment BUILD:development",
    "build": "rollup -c rollup.config.ts --configPlugin typescript --environment BUILD:production && tsc",
    "docs": "npm run generate-docs",
    "generate-docs": "typedoc",
    "build:docs": "tsx tools/build-and-docs.ts",
    "test": "vitest run --no-watch --exclude test/e2e --exclude test/integration",
    "pretest:e2e": "npm run build && npx vite build",
    "test:e2e": "vitest run test/e2e && npx playwright test",
    "test:integration": "vitest run test/integration",
    "test:vector-similarity": "vitest run test/vector-similarity",
    "test:prod": "vitest run --coverage --exclude test/e2e --exclude test/integration ",
    "bench": "vitest bench",
    "prepare": "husky",
    "v-pub-tarball": "npm publish --dry-run",
    "release": "release-it",
    "commit": "git-cz",
    "analyze-similarity": "tsx tools/vector-similarity/vector-similarity-analysis.ts",
    "test:packaging": "node tools/test-exports.cjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@playwright/test": "^1.57.0",
    "@release-it/conventional-changelog": "^9.0.4",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/d3": "^7.4.3",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/node": "^22.10.3",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.8",
    "chart.js": "^4.5.1",
    "commitizen": "^4.3.1",
    "conventional-commits-parser": "^6.4.0",
    "cz-git": "^1.11.0",
    "d3": "^7.9.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.7",
    "jsdom": "^27.0.1",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "release-it": "^17.11.0",
    "rollup": "^4.29.1",
    "rollup-plugin-delete": "^2.1.0",
    "semantic-release": "^25.0.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.14",
    "typescript": "^5.7.2",
    "undici-types": "^7.16.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue": "^3.5.31"
  },
  "keywords": [
    "algorithm",
    "data-structure",
    "typescript",
    "sorting",
    "graph",
    "tree"
  ],
  "overrides": {
    "tinypool": "^2.1.2",
    "basic-ftp": "^6.2.3",
    "ip-address": "^10.7.4",
    "picomatch": "^4.0.4",
    "tmp": "^0.2.6",
    "postcss-selector-parser": "^7.1.6"
  }
}
